// S1-Test (20.11.): wie placementradar/wrangler.jsonc, aber ohne Workers-AI-Bindung (die braucht Cloudflare-Login).
{
  "name": "placementradar-lokaltest",
  "main": "../placementradar/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "../placementradar/public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [{ "binding": "STORE", "id": "lokal" }],
  "vars": { "KEY_MODE": "shared", "MAX_VIDEO_S": "1200", "DAILY_ANALYSES": "10", "DAILY_IDENTIFY": "60", "DAILY_WORKERS_AI": "250" }
}
